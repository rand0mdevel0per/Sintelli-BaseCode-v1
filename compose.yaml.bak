services:
  python-40_cutlass_py:
    build:
      context: ./examples/40_cutlass_py
    restart: unless-stopped
    init: true
    # env_file: ./.env  # Uncomment if .env file exists
    # Default command runs gemm.py, as per Dockerfile
    # No ports exposed (no EXPOSE or README info)

  python-41_fused_multi_head_attention:
    build:
      context: ./examples/41_fused_multi_head_attention
    restart: unless-stopped
    init: true
    # env_file: ./.env  # Uncomment if .env file exists
    # Default command runs fmha_backward_test.py
    # No ports exposed (no EXPOSE or README info)

  python-44_multi_gemm_ir_and_codegen_ir_gen:
    build:
      context: ./examples/44_multi_gemm_ir_and_codegen/ir_gen
    restart: unless-stopped
    init: true
    # env_file: ./.env  # Uncomment if .env file exists
    # Default command runs gen_all_code.py
    # No ports exposed (no EXPOSE or README info)

  python-CuTeDSL_ampere:
    build:
      context: ./python/CuTeDSL/ampere
    restart: unless-stopped
    init: true
    # env_file: ./.env  # Uncomment if .env file exists
    # Default command runs call_bypass_dlpack module
    # No ports exposed (no EXPOSE or README info)

  python-CuTeDSL_blackwell_mamba2_ssd:
    build:
      context: ./python/CuTeDSL/blackwell/mamba2_ssd
    restart: unless-stopped
    init: true
    # env_file: ./.env  # Uncomment if .env file exists
    # Default command runs mamba2_ssd.py
    # No ports exposed (no EXPOSE or README info)

  python-CuTeDSL_cute_ffi:
    build:
      context: ./python/CuTeDSL/cute/ffi
    restart: unless-stopped
    init: true
    # env_file: ./.env  # Uncomment if .env file exists
    # Default command runs python (no main.py specified)
    # No ports exposed (no EXPOSE or README info)

  python-CuTeDSL_hopper:
    build:
      context: ./python/CuTeDSL/hopper
    restart: unless-stopped
    init: true
    # env_file: ./.env  # Uncomment if .env file exists
    # Default command runs hopper module
    # No ports exposed (no EXPOSE or README info)

# No external services detected in documentation or Dockerfiles
# No ports exposed, no volumes required
# All services use restart: unless-stopped and init: true for reliability
